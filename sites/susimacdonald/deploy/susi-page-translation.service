[Unit]
Description=Susi Mexican Spanish page translation checkpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=45min
WorkingDirectory=/home/admin/wix-site-bridge
ExecStart=/usr/bin/bash /home/admin/wix-site-bridge/sites/susimacdonald/scripts/run-page-translation-worker.sh --apply
