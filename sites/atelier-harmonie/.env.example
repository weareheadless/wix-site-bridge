# Exact selected Wix site ID; keep the manifest and this allowlist in sync.
WIX_ALLOWED_SITE_IDS=376faa89-fe6c-4ae8-8feb-10520e813a89

# Required for Custom Embeds through the Wix app identity. Never commit real values.
WIX_APP_ID=
WIX_APP_SECRET=
WIX_APP_INSTANCE_ID=

# Optional and only for the separate Wix CLI publishing flow.
WIX_CLI_API_KEY=
